# development | staging | production
ENV=development
# Base URL of enrichmint-api including the /api prefix.
API_URL=http://localhost:4100/api
# Name of the httpOnly session cookie.
TOKEN_NAME=enrichmint_session
# PayPal REST app client ID (SANDBOX). Public by design: the browser needs it to render the PayPal button.
PAYPAL_CLIENT_ID=
# sandbox | live. The hackathon build is sandbox only.
PAYPAL_ENV=sandbox
